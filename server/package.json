{
  "name": "stockpilot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StockPilot API - inventory management backend (Express + PostgreSQL)",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "seed": "node src/db/seed.js",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
